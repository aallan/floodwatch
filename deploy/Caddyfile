# Caddy serves the site over HTTPS, getting and renewing certificates for
# every name below once their DNS points at this server. Install with:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

tawriver.watch {
	encode zstd gzip
	# The MCP server, its server card and the AI Catalog; everything else is
	# the site.
	@agents path /mcp /mcp/* /.well-known/ai-catalog.json
	handle @agents {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8091 {
			header_down -Server
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8090 {
			header_down -Server
		}
	}
	header Strict-Transport-Security "max-age=31536000"
}

# The other name redirects, keeping the path.
www.tawriver.watch {
	redir https://tawriver.watch{uri} permanent
}
